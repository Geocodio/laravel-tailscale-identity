includes:
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - src
        - config
    tmpDir: build/phpstan
    ignoreErrors:
        # This IS the package's published config file; larastan only
        # recognizes an application's own config directory.
        - identifier: larastan.noEnvCallsOutsideOfConfig
          path: config/tailscale-identity.php
